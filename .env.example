# .env.example
# Copy this file to .env.local and fill in the actual values from your team lead
# DO NOT commit .env.local to git

MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here

# NextAuth (Google OAuth) — local dev must match `npm run dev` host (127.0.0.1:3000)
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=generate_a_long_random_string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical site URL (required for Instagram posting; use www subdomain)
# Instagram Graph API fetches the image from this URL – must be publicly reachable.
NEXT_PUBLIC_SITE_URL=https://www.chickenloop.com

# Stripe (payments / boosts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (recruiter/admin: AI parse job description → form fields)
OPENAI_API_KEY=

# Verified Talent Network (beta profile editor — set true on staging/preview)
TALENT_NETWORK_ENABLED=false

# When true, redirects legacy CV routes to Talent Network editor (production cutover)
TALENT_NETWORK_CUTOVER=false
